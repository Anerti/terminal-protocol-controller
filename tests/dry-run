#!/bin/bash

# Run every switch of bin/terminal-protocol-controller against a stub theme and stub
# omarchy, gsettings and plymouth commands, and check which theme steps each one calls.
# It never touches the desktop, so it is safe to run at any time.
#
# Usage: tests/dry-run

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
export TERMINAL_PROTOCOL_THEME_DIR="$TMP/theme" XDG_CACHE_HOME="$TMP/cache" PATH="$TMP/stubs:$PATH"
LOG="$TMP/steps"

mkdir -p "$TMP/theme/bin" "$TMP/stubs" "$TMP/theme/plugins/"{anerti.menu,anerti.lock,anerti.clock,anerti.workspaces}
printf '#!/bin/bash\nshift; echo "$*" >>%q\n' "$LOG" >"$TMP/theme/full-theme.sh"
printf '#!/bin/bash\n[[ $1 == status ]] && echo off || echo "crt $1" >>%q\n' "$LOG" >"$TMP/theme/bin/vault-tec-crt"
cat >"$TMP/stubs/omarchy" <<'STUB'
#!/bin/bash
echo '[{"id":"anerti.menu","enabled":false},{"id":"anerti.lock","enabled":true},{"id":"anerti.clock","enabled":true},{"id":"anerti.workspaces","enabled":true}]'
STUB
printf '#!/bin/bash\necho omarchy\n' >"$TMP/stubs/plymouth-set-default-theme"
printf '#!/bin/bash\necho "%s"\n' "'Adwaita'" >"$TMP/stubs/gsettings"
printf '#!/bin/bash\necho "vault-tec-cursor $1" >>%q\n' "$LOG" >"$TMP/theme/bin/vault-tec-cursor"
printf '#!/bin/bash\necho "terminal $*" >>%q\n' "$LOG" >"$TMP/stubs/omarchy-launch-floating-terminal-with-presentation"
chmod +x "$TMP/theme/bin/"* "$TMP/stubs/"*

failed=0
expect() {
  local args="$1" want="$2" got
  : >"$LOG"
  "$ROOT/bin/terminal-protocol-controller" $args
  got=$(paste -sd '|' "$LOG")
  if [[ $got == "$want" ]]; then echo "ok   $args"; else echo "FAIL $args: got '$got', want '$want'"; failed=1; fi
}

[[ $("$ROOT/bin/terminal-protocol-controller" status) == '{"installed":true,"busy":false,"bar":true,"menu":false,"cursor":false,"crt":false,"unlock":true,"login":false}' ]] &&
  echo "ok   status" || { echo "FAIL status: $("$ROOT/bin/terminal-protocol-controller" status)"; failed=1; }
expect "set menu on" "install_plugins anerti.menu|set_plugins on anerti.menu|place_bar vault|restart_shell"
expect "set bar off" "set_plugins off anerti.clock anerti.workspaces|enable_builtins anerti.clock anerti.workspaces|place_bar vault|restart_shell"
expect "set unlock off" "set_plugins off anerti.lock|enable_builtins anerti.lock|restart_shell"
expect "set cursor on" "set_cursors"
expect "set cursor off" "vault-tec-cursor uninstall"
expect "set crt on" "crt on"
expect "set login on" "terminal $TMP/theme/bin/vault-tec-plymouth install"
expect "set login off" "terminal $TMP/theme/bin/vault-tec-plymouth uninstall"

printf '#!/bin/bash\necho clone >>%q; sleep 0.3; mkdir -p "$5"; touch "$5/full-theme.sh"\n' "$LOG" >"$TMP/stubs/git"
chmod +x "$TMP/stubs/git"
: >"$LOG"
TERMINAL_PROTOCOL_THEME_DIR="$TMP/fresh" "$ROOT/bin/terminal-protocol-controller" install &
TERMINAL_PROTOCOL_THEME_DIR="$TMP/fresh" "$ROOT/bin/terminal-protocol-controller" install
wait
[[ $(paste -sd '|' "$LOG") == clone ]] && echo "ok   install twice" || { echo "FAIL install twice: $(paste -sd '|' "$LOG")"; failed=1; }
exit "$failed"
