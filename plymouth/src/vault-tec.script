# Dark Terminal Protocol boot screen: boot.html as a Plymouth script.
#
# Lock stage: the lock screen's RobCo terminal (anerti.lock), typing itself out: OMARCHY
# (TM) TERMINAL PROTOCOL, the emblem drawn in from the top, the banner (versions,
# copyright, hostname), a rule, then "> ENTER PASSWORD:" echoing an asterisk per
# character, over > VERIFYING... or > ACCESS DENIED. Init stage: Vault Boy, the progress
# bar and INITIALIZING SYSTEM... until the session starts. Shutdown and reboot type the
# terminal without its prompt.
#
# Every piece is cut from the mockup rendered at 1920x1080 (tools/build-plymouth); the
# layout block below says where each one sat. Other screens get the same layout scaled
# around the centre. Template: plymouth/src/vault-tec.script.

#@LAYOUT@

TICKS = 50;  # refresh rate of the script plugin

#----------------------------------------- Geometry --------------------------------

fun flag(condition) {
  if (condition) return 1;
  return 0;
}

fun geometry() {
  global.sw = Window.GetWidth();
  global.sh = Window.GetHeight();
  global.vw = global.sw;
  global.vh = global.sh;
  for (i = 0; i < 16 && Window.GetWidth(i); i++) {
    global.vw = Math.Min(global.vw, Window.GetWidth(i));
    global.vh = Math.Min(global.vh, Window.GetHeight(i));
  }
  global.s = Math.Min(global.vw / 1920, global.vh / 1080);
  global.top = (global.sh - global.vh) / 2;
  global.bottom = global.top + global.vh;
}

fun px(x) { return global.sw / 2 + (x - 960) * global.s; }
fun py(y) { return global.sh / 2 + (y - 540) * global.s; }

fun load(file) {
  image = Image(file);
  if (global.s != 1)
    image = image.Scale(Math.Int(image.GetWidth() * global.s + 0.5), Math.Int(image.GetHeight() * global.s + 0.5));
  return image;
}

fun piece(sprite, file, l, z) {
  sprite.SetImage(load(file));
  sprite.SetPosition(px(l.x), py(l.y), z);
}

#----------------------------------------- Backdrop and CRT --------------------------------

Window.SetBackgroundTopColor(0.008, 0.039, 0.020);
Window.SetBackgroundBottomColor(0.008, 0.039, 0.020);

background = Sprite();
vignette = Sprite();
scan.rows = 0;
beam.sprite = Sprite();
termlink = Sprite();
footer = Sprite();

fun setup_backdrop() {
  background.SetImage(Image("background.png").Scale(global.sw, global.sh));
  background.SetPosition(0, 0, -100);

  vignette.SetImage(Image("vignette.png").Scale(global.sw, global.sh));
  vignette.SetPosition(0, 0, 900);

  # Scanlines keep their 4px pitch at any height: the strip is tiled, not stretched.
  scan.image = Image("scanlines.png").Scale(global.sw, 40);
  for (row = 0; row * 40 < global.sh; row++) {
    if (!scan.sprite[row]) scan.sprite[row] = Sprite();
    scan.sprite[row].SetImage(scan.image);
    scan.sprite[row].SetPosition(0, row * 40, 901);
    scan.sprite[row].SetOpacity(1);
  }
  shown = row;
  for (row = shown; row < scan.rows; row++) scan.sprite[row].SetOpacity(0);
  if (shown > scan.rows) scan.rows = shown;

  # The rolling beam: 16% of the screen tall, from 18% above it down 8.5 of its heights in 8s.
  beam.h = global.sh * 0.16;
  beam.sprite.SetImage(Image("beam.png").Scale(global.sw, Math.Int(beam.h + 0.5)));
  beam.sprite.SetPosition(0, -global.sh * 0.18, 902);

  termlink.SetImage(load("termlink.png"));
  termlink.SetPosition(px(layout.termlink.x), global.top + layout.termlink.y * global.s, 10);

  # footer.png is the band y 1000-1080 of the grid, redrawn by render-footer with the
  # versions of the system the initramfs was built for.
  footer.SetImage(load("footer.png"));
  footer.SetPosition(px(0), global.bottom - 80 * global.s, 10);
}

#----------------------------------------- Lock stage --------------------------------

# The lock screen's timing: a character every 35 ms after 400 ms, 6 characters' pause
# between lines, 22 for the emblem and 10 for the rule.
TYPE_MS = 35;
PAUSE = 6;
LOGO_TICKS = 22;
RULE_TICKS = 10;
# The .1em tracking every line is padded with in front, at 20px and at the prompt's 26px.
PAD = 2;
PROMPT_PAD = 2.6;

emblem.sprite = Sprite();
reveal.sprite = Sprite();
rule.sprite = Sprite();
cursor.sprite = Sprite();
block.sprite = Sprite();
label.sprite = Sprite();
label.text = "";
label.y = 0;
answer.sprite = Sprite();

# The terminal's left edge and the stars' place after "> ENTER PASSWORD: ".
term.left = layout.rule_box.x;
term.right = layout.rule_box.x + layout.rule_box.w;
stars.x = layout.block.x;

# Typed lines: 0 the title, 1-3 the banner, 4 the prompt, 5 and 6 the status lines.
# Each has its sprite's place (x, y), its text box's left edge, its advance per character,
# its length and its cursor's centre.
for (i = 0; i < 7; i++) {
  line.sprite[i] = Sprite();
  line.sprite[i].SetOpacity(0);
  line.step[i] = layout.term_step;
  line.pad[i] = PAD;
}
line.file[1] = "banner-1.png";
line.file[2] = "banner-2.png";
line.file[3] = "banner-3.png";
line.file[0] = "title.png"; line.x[0] = layout.title.x; line.y[0] = layout.title.y;
line.chars[0] = layout.title_chars;
line.file[4] = "prompt.png"; line.x[4] = layout.prompt.x; line.y[4] = layout.prompt.y;
line.chars[4] = layout.prompt_chars; line.left[4] = term.left;
line.step[4] = layout.prompt_step; line.pad[4] = PROMPT_PAD;
line.cy[4] = layout.block.y + layout.block.h / 2;
line.file[5] = "verify.png"; line.x[5] = layout.verify.x; line.y[5] = layout.verify.y;
line.chars[5] = layout.verify_chars; line.left[5] = term.left;
line.file[6] = "denied.png"; line.x[6] = layout.denied.x; line.y[6] = layout.denied.y;
line.chars[6] = layout.denied_chars; line.left[6] = term.left;
line.left[0] = 960 - (PAD + line.chars[0] * line.step[0]) / 2;
line.cy[0] = layout.title.y + layout.title.h / 2;
# render-footer centres each banner line in CELL px a character plus MARGIN across.
BANNER_CELL = 13;
BANNER_MARGIN = 48;

# Enough stars to fill the row; the newest ones show once it overflows.
STARS = 48;
for (slot = 0; slot < STARS; slot++) {
  star.sprite[slot] = Sprite();
  star.sprite[slot].SetOpacity(0);
}

fun text_image(text, red, green, blue) {
  return Image.Text(text, red, green, blue, 1, "monospace " + Math.Int(13 * global.s + 0.5));
}

fun setup_lock() {
  emblem.image = load("emblem.png");
  emblem.sprite.SetPosition(px(layout.emblem.x), py(layout.emblem.y), 20);
  reveal.sprite.SetImage(load("reveal.png"));
  rule.image = load("rule.png");
  cursor.image = load("block.png");
  cursor.small = cursor.image.Scale(Math.Int(12 * global.s + 0.5), Math.Int(20 * global.s + 0.5));
  block.sprite.SetImage(cursor.image);
  star.image = load("star.png");
  for (slot = 0; slot < STARS; slot++) star.sprite[slot].SetImage(star.image);

  for (i = 0; i < 7; i++) {
    line.image[i] = load(line.file[i]);
    line.shown[i] = -1;
  }
  # The banner lines are centred, so their text boxes follow from their widths.
  for (i = 1; i <= 3; i++) {
    w = line.image[i].GetWidth() / global.s;
    h = line.image[i].GetHeight() / global.s;
    line.chars[i] = 0;
    if (w > BANNER_MARGIN) line.chars[i] = Math.Int((w - BANNER_MARGIN) / BANNER_CELL + 0.5);
    line.x[i] = 960 - w / 2;
    line.cy[i] = layout.banner_line.y + layout.banner_line.h / 2 + (i - 1) * layout.banner_pitch;
    line.y[i] = line.cy[i] - h / 2;
    line.left[i] = 960 - (PAD + line.chars[i] * layout.term_step) / 2;
  }
  emblem.cut = -1;
  rule.cut = -1;
  plan();
  set_label(label.text);
}

# When each piece starts typing, in characters, as the lock screen lays its timeline out.
fun plan() {
  t = line.chars[0] + PAUSE;
  global.logo_start = t;
  t += LOGO_TICKS + PAUSE;
  for (i = 1; i <= 3; i++) {
    line.start[i] = t;
    if (line.chars[i]) t += line.chars[i] + PAUSE;
    line.until[i] = t;
  }
  line.start[0] = 0;
  line.until[0] = global.logo_start;
  global.rule_start = t;
  global.prompt_start = t + RULE_TICKS + PAUSE;
}

# Characters typed so far; a key press shows everything at once, as on the lock screen.
global.skip = 0;
fun typed() {
  if (global.skip) return 100000;
  ms = global.tick * 1000 / TICKS - 400;
  if (ms < 0) return -1;
  return Math.Int(ms / TYPE_MS);
}

fun set_label(text) {
  label.text = text;
  if (text == "") {
    label.sprite.SetOpacity(0);
    return;
  }
  label.sprite.SetImage(text_image(text, 0.486, 0.580, 0.502));
  label.y = py(layout.verify.y + layout.verify.h / 2) - label.sprite.GetImage().GetHeight() / 2;
}

# Line i with its first n characters, cropped at the next one's text box.
fun draw_line(i, n, visible) {
  if (n > line.chars[i]) n = line.chars[i];
  if (!visible || n <= 0) {
    line.sprite[i].SetOpacity(0);
    return;
  }
  if (n != line.shown[i]) {
    image = line.image[i];
    if (n < line.chars[i]) {
      w = Math.Int((line.left[i] + line.pad[i] + n * line.step[i] - line.x[i]) * global.s + 0.5);
      if (w < 1) {
        line.sprite[i].SetOpacity(0);
        return;
      }
      if (w < image.GetWidth()) image = image.Crop(0, 0, w, image.GetHeight());
    }
    line.sprite[i].SetImage(image);
    line.shown[i] = n;
  }
  line.sprite[i].SetPosition(px(line.x[i]), py(line.y[i]), 20);
  line.sprite[i].SetOpacity(1);
}

# The typing cursor: after the n characters of line i, while that line is typing.
fun draw_cursor(i, n) {
  if (i == 4) image = cursor.image;
  else image = cursor.small;
  if (n > line.chars[i]) n = line.chars[i];
  x = line.left[i] + line.pad[i] + n * line.step[i];
  cursor.sprite.SetImage(image);
  cursor.sprite.SetPosition(px(x), py(line.cy[i]) - image.GetHeight() / 2, 21);
  cursor.sprite.SetOpacity(flag(global.blink_on));
}

fun draw_emblem(visible, k) {
  r = (k - global.logo_start) / LOGO_TICKS;
  if (!visible || r <= 0) {
    emblem.sprite.SetOpacity(0);
    reveal.sprite.SetOpacity(0);
    return;
  }
  if (r > 1) r = 1;
  # Its glow above, then as much of the mark as has been drawn.
  if (r != emblem.cut) {
    emblem.cut = r;
    image = emblem.image;
    if (r < 1) {
      h = Math.Int((layout.emblem_box.y - layout.emblem.y + layout.emblem_box.h * r) * global.s + 0.5);
      if (h > 0) image = image.Crop(0, 0, image.GetWidth(), h);
    }
    emblem.sprite.SetImage(image);
  }
  emblem.sprite.SetPosition(px(layout.emblem.x), py(layout.emblem.y), 20);
  # @keyframes holo, 4.5s ease-in-out: opacity .92 -> 1 -> .92.
  emblem.sprite.SetOpacity(0.96 - 0.04 * Math.Cos(2 * Math.Pi * global.tick / TICKS / 4.5));

  reveal.sprite.SetPosition(px(layout.reveal.x), py(layout.reveal.y + layout.emblem_box.h * r - layout.emblem_box.h), 21);
  reveal.sprite.SetOpacity(flag(r < 1));
}

# The rule grows out from the centre.
fun draw_rule(visible, k) {
  f = (k - global.rule_start) / RULE_TICKS;
  if (!visible || f <= 0) {
    rule.sprite.SetOpacity(0);
    return;
  }
  if (f > 1) f = 1;
  glow = layout.rule_box.x - layout.rule.x;
  if (f != rule.cut) {
    rule.cut = f;
    image = rule.image;
    if (f < 1) {
      w = Math.Int((layout.rule_box.w * f + 2 * glow) * global.s + 0.5);
      image = image.Crop(Math.Int((image.GetWidth() - w) / 2), 0, w, image.GetHeight());
    }
    rule.sprite.SetImage(image);
  }
  rule.sprite.SetPosition(px(960) - rule.sprite.GetImage().GetWidth() / 2, py(layout.rule.y), 20);
  rule.sprite.SetOpacity(1);
}

global.state = "focus";
global.bullets = 0;
global.prompted = 0;
global.question = 0;
global.first_prompt = "";
global.many_prompts = 0;
global.prompt_from = 0;
global.status_tick = 0;
global.phase = 0;
global.blink_on = 1;

# The status line, retyped whenever it changes: VERIFYING... while the passphrase is
# checked, ACCESS DENIED (red) once it is refused, until typing starts again.
fun set_state(name) {
  if (name != global.state) global.status_tick = global.tick;
  global.state = name;
}

fun draw_terminal() {
  visible = flag(global.stage != "init");
  prompt = flag(global.stage == "lock");
  k = typed();
  # steps(1) blink, 500 ms on and off.
  global.phase = Math.Int(global.tick * 2 / TICKS) % 2;
  global.blink_on = global.phase == 0;
  typing = -1;

  for (i = 0; i <= 3; i++) {
    draw_line(i, k - line.start[i], visible);
    if (visible && k >= line.start[i] && k < line.until[i] && line.chars[i]) {
      typing = i;
      n = k - line.start[i];
    }
  }
  draw_emblem(visible, k);
  draw_rule(visible, k);

  # The prompt types once the rule is down and the passphrase has been asked for.
  p = k - global.prompt_from;
  draw_line(4, p, prompt);
  ready = prompt && p >= line.chars[4];
  if (prompt && !ready && p >= 0) {
    typing = 4;
    n = p;
  }
  if (typing >= 0) draw_cursor(typing, n);
  else cursor.sprite.SetOpacity(0);

  # The stars, then the block; once they reach the right edge, the row scrolls left.
  count = global.bullets;
  if (global.question || !ready) count = 0;
  shift = stars.x + count * layout.prompt_step + layout.block.w - term.right;
  if (shift < 0) shift = 0;
  first = 0;
  if (count > STARS) first = count - STARS;
  for (i = 0; i < STARS; i++) {
    x = stars.x + (first + i) * layout.prompt_step - shift;
    star.sprite[i].SetPosition(px(x + layout.star.x - stars.x), py(layout.star.y), 20);
    star.sprite[i].SetOpacity(flag(first + i < count && x >= stars.x - 0.5));
  }
  block.sprite.SetPosition(px(layout.block.x + count * layout.prompt_step - shift), py(layout.block.y), 20);
  on = global.state == "focus" || global.state == "error";
  block.sprite.SetOpacity(flag(ready && on && !global.question && global.blink_on));

  answer.sprite.SetOpacity(flag(ready && global.question));
  if (global.question)
    answer.sprite.SetPosition(px(stars.x), py(line.cy[4]) - answer.sprite.GetImage().GetHeight() / 2, 20);

  n = Math.Int((global.tick - global.status_tick) * 1000 / TICKS / TYPE_MS);
  draw_line(5, n, ready && global.state == "checking");
  draw_line(6, n, ready && global.state == "error");
  x = term.left + PAD;
  if (global.state == "error") x += (line.chars[6] + 2) * line.step[6];
  label.sprite.SetPosition(px(x), label.y, 20);
  denied = global.state == "error" && n >= line.chars[6];
  label.sprite.SetOpacity(flag(ready && label.text != "" && (global.state == "focus" || denied)));
}

#----------------------------------------- Init stage --------------------------------

boy.sprite = Sprite();
bar.sprite = Sprite();
pct.sprite = Sprite();

fun setup_init() {
  boy.sprite.SetPosition(px(810 - layout.boy_pad), py(layout.bar_box.y - 36 - 20 - 390 - layout.boy_pad), 20);
  bar.sprite.SetPosition(px(layout.bar_box.x), py(layout.bar_box.y), 20);
  pct.sprite.SetPosition(px(layout.bar_box.x + layout.bar_box.w + 14 - layout.pct_pad),
                         py(layout.bar_box.y + layout.bar_box.h / 2 - 10 - layout.pct_pad), 20);
}

status.sprite = Sprite();
status.file[1] = "status-1.png"; status.x[1] = layout.status_1.x; status.y[1] = layout.status_1.y;
status.file[2] = "status-2.png"; status.x[2] = layout.status_2.x; status.y[2] = layout.status_2.y;
status.file[3] = "status-3.png"; status.x[3] = layout.status_3.x; status.y[3] = layout.status_3.y;

# Frames are loaded the first time they are shown, so the lock stage comes up fast.
cache.loaded = 0;
global.generation = 0;
fun cached(file) {
  key = global.generation + ":" + file;
  if (!cache[key]) cache[key] = load(file);
  return cache[key];
}

# The mockup's INIT_STEPS: percent reached at each cumulative time, with a .3s linear
# transition on the bar. It holds at 94% until the boot itself reports more.
steps.ms[0] = 600;  steps.pct[0] = 7;
steps.ms[1] = 1500; steps.pct[1] = 19;
steps.ms[2] = 2300; steps.pct[2] = 32;
steps.ms[3] = 3000; steps.pct[3] = 45;
steps.ms[4] = 3900; steps.pct[4] = 58;
steps.ms[5] = 4700; steps.pct[5] = 71;
steps.ms[6] = 5400; steps.pct[6] = 84;
steps.ms[7] = 6000; steps.pct[7] = 94;

global.target = 0;
global.bar_from = 0;
global.bar_now = 0;
global.bar_tick = 0;
global.real = 0;

fun set_target(value) {
  if (value > 100) value = 100;
  if (value > global.target) {
    global.bar_from = global.bar_now;
    global.target = value;
    global.bar_tick = global.tick;
  }
}

fun draw_init(visible) {
  t = global.tick - global.init_tick;
  ms = t * 1000 / TICKS;
  for (i = 0; steps.ms[i]; i++)
    if (ms >= steps.ms[i]) set_target(steps.pct[i]);
  set_target(Math.Int(global.real * 100));

  u = (global.tick - global.bar_tick) / (0.3 * TICKS);
  if (u > 1) u = 1;
  global.bar_now = global.bar_from + (global.target - global.bar_from) * u;

  bar.sprite.SetImage(cached(bar.file[Math.Int(global.bar_now + 0.5)]));
  pct.sprite.SetImage(cached(pct.file[global.target]));
  # 60 ms frames: one every 3 ticks.
  boy.sprite.SetImage(cached(boy.file[Math.Int(t / 3) % layout.boy_frames]));

  # INITIALIZING SYSTEM. .. ... every 420 ms.
  n = Math.Int(t / (0.42 * TICKS)) % 3 + 1;
  status.sprite.SetImage(cached(status.file[n]));
  status.sprite.SetPosition(px(status.x[n]), py(status.y[n]), 20);

  boy.sprite.SetOpacity(visible);
  bar.sprite.SetOpacity(visible);
  pct.sprite.SetOpacity(visible);
  status.sprite.SetOpacity(visible);
}

#----------------------------------------- Stages --------------------------------

# lock: waiting for (or checking) the passphrase. init: unlocked, booting.
# idle: shutdown and reboot, or the boot before a prompt shows up: the terminal, no prompt.
global.stage = "idle";
global.tick = 0;
global.init_tick = 0;
global.drawn = "";

fun apply_stage() {
  name = global.stage;
  termlink.SetOpacity(flag(name == "init"));
  footer.SetOpacity(flag(name == "init"));
  draw_terminal();
  draw_init(flag(name == "init"));
}

fun show_stage(name) {
  global.stage = name;
  if (name == "lock") {
    # The prompt types after the rule, or as soon as it is asked for if that is later.
    global.prompt_from = 0;
    if (!global.skip) global.prompt_from = Math.Max(global.prompt_start, typed());
  }
  if (name == "init") {
    global.init_tick = global.tick;
    global.target = 0;
    global.bar_from = 0;
    global.bar_now = 0;
  }
  apply_stage();
}

# What the terminal shows this tick, past which redrawing it changes nothing: the
# characters typed up to the end of the prompt, the status line's and the blink.
fun terminal_frame() {
  k = typed();
  end = global.prompt_start;
  if (global.stage == "lock") end = global.prompt_from + line.chars[4] + 1;
  if (k > end) k = end;
  n = Math.Int((global.tick - global.status_tick) * 1000 / TICKS / TYPE_MS);
  if (n > 20) n = 20;
  return k + ":" + n + ":" + Math.Int(global.tick * 2 / TICKS) % 2;
}

fun refresh_callback() {
  global.tick++;
  t = global.tick / TICKS;
  # The slow, large layers move at 25 fps: half the redraw for no visible difference.
  even = global.tick % 2 == 0;

  # Rolling beam, 8s per pass.
  if (even) {
    f = t / 8 - Math.Int(t / 8);
    beam.sprite.SetY(-global.sh * 0.18 + f * 8.5 * beam.h);
  }

  if (global.stage == "init") {
    draw_init(1);
  } else {
    frame = terminal_frame();
    if (frame != global.drawn) {
      global.drawn = frame;
      draw_terminal();
    } else if (even) {
      # @keyframes holo, 4.5s ease-in-out: opacity .92 -> 1 -> .92.
      if (emblem.cut > 0) emblem.sprite.SetOpacity(0.96 - 0.04 * Math.Cos(2 * Math.Pi * t / 4.5));
    }
  }

  if (global.stage == "lock") {
    # No answer either way. An opened volume normally reports through the root-mounted
    # callback within seconds; this is only the fallback, long enough that a refused
    # passphrase (every keyslot tried, slow on slow hardware) re-prompts first.
    if (global.state == "checking" && global.tick - global.check_tick >= 20 * TICKS) granted();
  } else if (global.stage == "idle" && Plymouth.GetMode() == "boot" && global.tick >= 6 * TICKS &&
             typed() >= global.prompt_start && !global.prompted) {
    # Nothing to unlock: go straight to initializing.
    show_stage("init");
  }
}

Plymouth.SetRefreshFunction(refresh_callback);

#----------------------------------------- Passphrase --------------------------------

# Accepted: on to initializing.
fun granted() {
  if (global.stage == "lock" && global.state == "checking") {
    set_state("focus");
    show_stage("init");
  }
}

fun note_prompt(prompt) {
  if (global.first_prompt == "") global.first_prompt = prompt;
  else if (prompt != global.first_prompt) global.many_prompts = 1;
  if (global.many_prompts) set_label(prompt);
  else set_label("");
}

# Asked again after an answer: the passphrase was refused.
fun asked() {
  global.prompted = 1;
  if (global.stage != "lock") show_stage("lock");
  if (global.state == "checking") set_state("error");
}

fun display_password_callback(prompt, bullets) {
  global.question = 0;
  note_prompt(prompt);
  asked();
  # Typing shows the whole terminal at once and clears ACCESS DENIED.
  if (bullets > 0) {
    global.skip = 1;
    if (global.state == "error") set_state("focus");
  }
  global.bullets = bullets;
  draw_terminal();
}

fun display_normal_callback() {
  # The prompt was answered (or never shown): it empties while the answer is checked.
  if (global.stage == "lock" && global.state != "checking") {
    set_state("checking");
    global.check_tick = global.tick;
    global.bullets = 0;
    draw_terminal();
  }
}

fun display_question_callback(prompt, entry) {
  global.question = 1;
  set_label(prompt);
  answer.sprite.SetImage(text_image(entry + "_", 0.173, 0.682, 0.180));
  asked();
  if (entry != "") {
    global.skip = 1;
    if (global.state == "error") set_state("focus");
  }
  draw_terminal();
}

# The root filesystem mounted, or systemd reporting the encrypted volume open.
fun root_mounted_callback() {
  granted();
}

fun update_status_callback(text) {
  if (text.SubString(0, 19) == "systemd-cryptsetup@") granted();
}

message.sprite = Sprite();
message.text = "";

fun draw_message() {
  if (message.text == "") {
    message.sprite.SetOpacity(0);
    return;
  }
  message.sprite.SetImage(text_image(message.text, 0.173, 0.682, 0.180));
  message.sprite.SetPosition(px(960) - message.sprite.GetImage().GetWidth() / 2,
                             py(832) - message.sprite.GetImage().GetHeight() / 2, 20);
  message.sprite.SetOpacity(1);
}

fun display_message_callback(text) {
  message.text = text;
  draw_message();
}

fun hide_message_callback(text) {
  if (text == message.text) {
    message.text = "";
    draw_message();
  }
}

fun quit_callback() {
  if (global.stage == "init") {
    set_target(100);
    global.bar_from = 100;
    draw_init(1);
  }
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetRootMountedFunction(root_mounted_callback);
Plymouth.SetUpdateStatusFunction(update_status_callback);
Plymouth.SetQuitFunction(quit_callback);

fun progress_callback(duration, progress) {
  global.real = progress;
}

Plymouth.SetBootProgressFunction(progress_callback);

fun setup() {
  geometry();
  global.generation++;
  setup_backdrop();
  setup_lock();
  setup_init();
  draw_message();
}

fun hotplug_callback() {
  setup();
  apply_stage();
}

Plymouth.SetDisplayHotplugFunction(hotplug_callback);

setup();
show_stage("idle");
