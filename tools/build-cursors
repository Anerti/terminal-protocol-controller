#!/usr/bin/env python3
# Build the VaultTec XCursor theme (cursors/VaultTec) from the mockup's cursor SVGs
# (assets/css/fallout.css --cursor-*). Shapes it does not draw are inherited from Adwaita.
# Needs rsvg-convert and magick.
# Usage: tools/build-cursors

import os
import shutil
import struct
import subprocess
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(ROOT, "cursors", "VaultTec")

FILL = "#2cae2e"
INK = "#04160b"

WEDGE = (
    '<svg xmlns="http://www.w3.org/2000/svg" width="25" height="33" viewBox="0 0 25 33">'
    f'<path d="M2 2 L23 23 L10.4 23 L2 31.4 Z" fill="{FILL}" stroke="{INK}" stroke-width="1.6" stroke-linejoin="miter"/>'
    "</svg>"
)
IBEAM = (
    '<svg xmlns="http://www.w3.org/2000/svg" width="17" height="25" viewBox="0 0 17 25">'
    f'<path d="M3 2 H14 V5 H10.5 V20 H14 V23 H3 V20 H6.5 V5 H3 Z" fill="{FILL}" stroke="{INK}" stroke-width="1.6"/>'
    "</svg>"
)
OFF = (
    '<svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 25 25">'
    f'<circle cx="12.5" cy="12.5" r="10.2" fill="{FILL}" stroke="{INK}" stroke-width="2"/>'
    f'<path d="M6.2 18.8 L18.8 6.2" stroke="{INK}" stroke-width="2" fill="none"/>'
    "</svg>"
)

SHAPES = {
    "default": (WEDGE, 25, 33, 2, 2, ["left_ptr", "arrow", "top_left_arrow", "left_arrow"]),
    "pointer": (WEDGE, 25, 33, 2, 2, [
        "hand", "hand1", "hand2", "pointing_hand",
        "e29285e634086352946a0e7090d73106", "9d800788f1b08800ae810202380a0822",
    ]),
    "text": (IBEAM, 17, 25, 8, 12, ["xterm", "ibeam"]),
    "not-allowed": (OFF, 25, 25, 12, 12, [
        "crossed_circle", "forbidden", "circle", "no-drop", "dnd-no-drop",
        "03b6e0fcb3499374a867c041f52298f0",
    ]),
}

NOMINAL = [24, 32, 48, 64]


def render(svg, width, height, tmp):
    src = os.path.join(tmp, "in.svg")
    png = os.path.join(tmp, "out.png")
    with open(src, "w") as f:
        f.write(svg)
    subprocess.run(["rsvg-convert", "-w", str(width), "-h", str(height), "-o", png, src], check=True)
    raw = subprocess.run(["magick", png, "-depth", "8", "rgba:-"], check=True, capture_output=True).stdout
    pixels = []
    for i in range(0, len(raw), 4):
        r, g, b, a = raw[i:i + 4]
        r, g, b = (r * a + 127) // 255, (g * a + 127) // 255, (b * a + 127) // 255
        pixels.append((a << 24) | (r << 16) | (g << 8) | b)
    return pixels


def xcursor(images):
    header = struct.pack("<4sIII", b"Xcur", 16, 0x10000, len(images))
    toc_size = 12 * len(images)
    position = 16 + toc_size
    toc = b""
    chunks = b""
    for size, width, height, xhot, yhot, pixels in images:
        toc += struct.pack("<III", 0xFFFD0002, size, position)
        chunk = struct.pack("<IIIIIIIII", 36, 0xFFFD0002, size, 1, width, height, xhot, yhot, 0)
        chunk += struct.pack("<%dI" % len(pixels), *pixels)
        chunks += chunk
        position += len(chunk)
    return header + toc + chunks


def main():
    if os.path.isdir(OUT):
        shutil.rmtree(OUT)
    os.makedirs(os.path.join(OUT, "cursors"))
    with open(os.path.join(OUT, "index.theme"), "w") as f:
        f.write("[Icon Theme]\nName=VaultTec\nComment=Vault-Tec phosphor cursors\nInherits=Adwaita\n")

    with tempfile.TemporaryDirectory() as tmp:
        for name, (svg, w, h, xhot, yhot, aliases) in SHAPES.items():
            images = []
            for size in NOMINAL:
                scale = size / 24
                width, height = round(w * scale), round(h * scale)
                pixels = render(svg, width, height, tmp)
                images.append((size, width, height, round(xhot * scale), round(yhot * scale), pixels))
            with open(os.path.join(OUT, "cursors", name), "wb") as f:
                f.write(xcursor(images))
            # Aliases are copies, not symlinks: omarchy plugin validate refuses symlinks inside
            # a plugin folder, and the cursors ship inside the controller plugin.
            for alias in aliases:
                shutil.copy(os.path.join(OUT, "cursors", name), os.path.join(OUT, "cursors", alias))
    print(OUT)


if __name__ == "__main__":
    main()
