#!/bin/bash

# Install or remove the Vault-Tec boot screen: the Plymouth theme built by
# tools/build-plymouth from boot.html, shown from power-on to the LUKS passphrase and
# on until the session starts. Asks for sudo, then rebuilds the initramfs.
#
# Its banner and footer name the Omarchy version, the kernel and the hostname. An initcpio
# hook redraws them into every initramfs for the kernel that initramfs boots, and a pacman
# hook rebuilds the initramfs when Omarchy itself is upgraded, so both stay current.
#
# test plays it on the console you run it from (Ctrl+Alt+F3, log in; not inside the
# desktop, which holds the screen): passphrase "omarchy", anything else is refused.
#
# Usage: vault-tec-plymouth [install|uninstall|test]   (default: install)

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
THEME=/usr/share/plymouth/themes/vault-tec
INITCPIO_HOOK=/etc/initcpio/install/vault-tec-plymouth
INITCPIO_CONF=/etc/mkinitcpio.conf.d/zz-vault-tec-plymouth.conf
PACMAN_HOOK=/etc/pacman.d/hooks/vault-tec-plymouth.hook
PREVIOUS=/var/lib/vault-tec-plymouth/previous-theme
# Drawn by render-footer for each initramfs, so never compared with the build.
LIVE="footer.png banner-1.png banner-2.png banner-3.png"

rebuild() {
  if command -v limine-mkinitcpio >/dev/null; then
    sudo limine-mkinitcpio
  else
    sudo mkinitcpio -P
  fi
}

# The passphrase is typed on this screen, so install only a complete build: the script
# (written last by tools/build-plymouth) and every image it names.
check_build() {
  local dir=$ROOT/plymouth/vault-tec file missing=()
  if [[ ! -f $dir/vault-tec.script ]]; then
    echo "plymouth/vault-tec is missing or incomplete: run tools/build-plymouth first" >&2
    exit 1
  fi
  for file in vault-tec.plymouth render-footer $LIVE \
    $(grep -o '"[A-Za-z0-9_-]*\.png"' "$dir/vault-tec.script" | tr -d '"' | sort -u); do
    [[ -s $dir/$file ]] || missing+=("$file")
  done
  if ((${#missing[@]})); then
    echo "plymouth/vault-tec is incomplete (${missing[*]}): run tools/build-plymouth again" >&2
    exit 1
  fi
  "$ROOT/tools/build-plymouth" --check
}

put() {
  local tmp
  tmp=$(mktemp)
  cat >"$tmp"
  if cmp -s "$tmp" "$2"; then
    rm -f "$tmp"
    return 1
  fi
  sudo install -D -m "$1" "$tmp" "$2"
  rm -f "$tmp"
}

install() {
  check_build
  local changed=0 live file

  # The banner and footer are baked into each initramfs by the hook, so new ones need a
  # rebuild too.
  live=$(mktemp -d)
  if ! "$ROOT/plymouth/vault-tec/render-footer" "$live"; then
    rm -rf "$live"
    echo "render-footer could not draw this system's banner and footer (needs magick)" >&2
    exit 1
  fi

  if ! diff -rq -x footer.png -x 'banner-*.png' "$ROOT/plymouth/vault-tec" "$THEME" >/dev/null 2>&1; then
    sudo install -d -m 0755 "$THEME"
    sudo rsync -a --delete --exclude=footer.png --exclude='banner-*.png' --chown=root:root --chmod=D755,F644 \
      "$ROOT/plymouth/vault-tec/" "$THEME/"
    sudo chmod 0755 "$THEME/render-footer"
    changed=1
  fi

  for file in $LIVE; do
    put 0644 "$THEME/$file" <"$live/$file" && changed=1
  done
  rm -rf "$live"

  put 0644 "$INITCPIO_HOOK" <<'EOF' && changed=1
#!/bin/bash

# Vault-Tec boot screen: draw the banner and footer for the kernel this initramfs boots.
build() {
  local theme=/usr/share/plymouth/themes/vault-tec live file

  [[ $(plymouth-set-default-theme) == vault-tec && -x $theme/render-footer ]] || return 0
  live=$(mktemp -d)
  if "$theme/render-footer" "$live" "$KERNELVERSION"; then
    for file in "$live"/*.png; do
      add_file "$file" "$theme/${file##*/}" 644
    done
  else
    warning "vault-tec-plymouth: banner and footer not redrawn, keeping the installed ones"
  fi
  rm -rf "$live"
}

help() {
  echo "Redraws the Vault-Tec Plymouth banner and footer (Omarchy, kernel, hostname) per initramfs."
}
EOF

  # After plymouth, which copies the theme the banner and footer are drawn over.
  echo 'HOOKS+=(vault-tec-plymouth)' | put 0644 "$INITCPIO_CONF" && changed=1

  put 0644 "$PACMAN_HOOK" <<'EOF' || true
[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Target = omarchy
Target = omarchy-dev

[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/modules/*/vmlinuz

[Action]
Description = Redrawing the Vault-Tec boot screen banner and footer...
When = PostTransaction
NeedsTargets
Exec = /bin/sh -c 'theme=/usr/share/plymouth/themes/vault-tec; [ "$(plymouth-set-default-theme)" = vault-tec ] || exit 0; "$theme/render-footer" "$theme" || true; grep -q "^usr/lib/modules/" && exit 0; if command -v limine-mkinitcpio >/dev/null; then limine-mkinitcpio; else mkinitcpio -P; fi'
EOF

  local current
  current=$(plymouth-set-default-theme)
  if [[ $current != vault-tec ]]; then
    echo "$current" | put 0644 "$PREVIOUS" || true
    sudo plymouth-set-default-theme vault-tec
    changed=1
  fi

  if ((changed)); then
    rebuild
  else
    echo "The Vault-Tec boot screen is installed and current."
  fi
}

uninstall() {
  local previous
  sudo rm -f "$INITCPIO_HOOK" "$INITCPIO_CONF" "$PACMAN_HOOK"
  if [[ $(plymouth-set-default-theme) == vault-tec ]]; then
    previous=$(cat "$PREVIOUS" 2>/dev/null || true)
    if [[ -z $previous || $previous == vault-tec || ! -d /usr/share/plymouth/themes/$previous ]]; then
      previous=omarchy
    fi
    sudo rm -f "$PREVIOUS"
    sudo rm -rf "$THEME"
    sudo plymouth-set-default-theme "$previous"
    rebuild
  else
    sudo rm -f "$PREVIOUS"
    sudo rm -rf "$THEME"
  fi
}

test_run() {
  if [[ $(plymouth-set-default-theme) != vault-tec ]]; then
    echo "The vault-tec theme is not installed: run vault-tec-plymouth install first" >&2
    exit 1
  fi
  local log=/tmp/plymouth-vault-tec.log
  sudo plymouthd --mode=boot --tty="$(tty)" --debug --debug-file="$log"
  # Give the console back however the test ends: Ctrl+C, a failed step or the end.
  trap 'sudo plymouth quit 2>/dev/null || true' EXIT
  sudo plymouth show-splash
  # As the encrypt hook asks: plymouth re-prompts until the command accepts it.
  sudo plymouth ask-for-password --number-of-tries=3 --command="grep -qx omarchy" || true
  sleep 2
  sudo plymouth update-root-fs --new-root-dir=/
  sleep 9
  echo "Debug log: $log"
}

case "${1:-install}" in
  install) install ;;
  uninstall) uninstall ;;
  test) test_run ;;
  *)
    echo "Usage: vault-tec-plymouth [install|uninstall|test]" >&2
    exit 1
    ;;
esac
