#!/bin/bash

# Usage: terminal-protocol-controller [status|install|set <bar|menu|cursor|crt|unlock|login> <on|off>]

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REPO=https://github.com/Anerti/omarchy-dark-terminal-protocol-theme.git
THEME_DIR="${TERMINAL_PROTOCOL_THEME_DIR:-$HOME/.config/omarchy/themes/dark-terminal-protocol}"
PLUGINS="$HOME/.config/omarchy/plugins"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/terminal-protocol-controller"
LOCK="$CACHE/control.lock"
LOGIN_LOCK="$CACHE/login.lock"

mkdir -p "$CACHE"

run() {
  "$ROOT/bin/vault-tec-plugins" "$@" >>"$CACHE/control.log" 2>&1
}

installed() {
  local dir
  [[ -f $THEME_DIR/colors.toml ]] || return
  for dir in "$ROOT"/plugins/*/; do
    [[ -d $PLUGINS/$(basename "$dir") ]] || return
  done
}

bar_ids() {
  local dir id
  for dir in "$ROOT"/plugins/*/; do
    id=$(basename "$dir")
    [[ $id == anerti.menu || $id == anerti.lock ]] || echo "$id"
  done
}

cursor_installed() {
  local hooks="$HOME/.config/omarchy/hooks"
  [[ -d $HOME/.local/share/icons/VaultTec && -f $hooks/theme-set.d/vault-tec-cursor && -f $hooks/post-boot.d/vault-tec-cursor ]]
}

status() {
  local busy=false
  flock -n "$LOCK" true || busy=true
  installed || { echo "{\"installed\":false,\"busy\":$busy}"; return; }
  { omarchy plugin list --json 2>/dev/null || echo '[]'; } | jq -c \
    --argjson busy "$busy" \
    --argjson bar "$(jq -cn '$ARGS.positional' --args $(bar_ids))" \
    --arg boot "$(plymouth-set-default-theme 2>/dev/null)" \
    --arg crt "$("$ROOT/bin/vault-tec-crt" status)" \
    --argjson cursor "$(cursor_installed && echo true || echo false)" '
    . as $list
    | def on($id): any($list[]; .id == $id and .enabled);
    {
      installed: true,
      busy: $busy,
      bar: ($bar | length > 0 and all(.[]; on(.))),
      menu: on("anerti.menu"),
      cursor: $cursor,
      crt: ($crt == "on"),
      unlock: on("anerti.lock"),
      login: ($boot == "vault-tec")
    }'
}

install() {
  exec 9>"$LOCK"
  flock 9
  if [[ ! -f $THEME_DIR/colors.toml ]]; then
    local part="$THEME_DIR.part"
    rm -rf "$part"
    mkdir -p "$(dirname "$THEME_DIR")"
    git clone --depth 1 "$REPO" "$part" || { rm -rf "$part"; exit 1; }
    [[ -e $THEME_DIR ]] && mv "$THEME_DIR" "$THEME_DIR.broken-$(date +%s)"
    mv "$part" "$THEME_DIR" || exit 1
  fi
  run sync
}

toggle() {
  local want="$1"
  shift
  if [[ $want == on ]]; then
    run install "$@" && run enable "$@"
  else
    run disable "$@"
  fi
}

place_bar() {
  local now
  now=$(status)
  if [[ $(jq -r .bar <<<"$now") == true ]]; then
    run place-bar vault
  else
    run place-bar builtin "$([[ $(jq -r .menu <<<"$now") == true ]] && echo on || echo off)"
  fi
}

set_part() {
  local part="$1" want="$2" ids
  [[ $want == on || $want == off ]] || usage
  installed || { echo "The theme or its plugins are not installed: run terminal-protocol-controller install" >&2; exit 1; }

  exec 9>"$LOCK"
  flock 9

  case "$part" in
    bar) mapfile -t ids < <(bar_ids); toggle "$want" "${ids[@]}" && place_bar ;;
    menu) toggle "$want" anerti.menu && place_bar ;;
    unlock) toggle "$want" anerti.lock ;;
    cursor)
      "$ROOT/bin/vault-tec-cursor" "$([[ $want == on ]] && echo install || echo uninstall)"
      return
      ;;
    crt) "$ROOT/bin/vault-tec-crt" "$want"; return ;;
    login)
      local cmd
      printf -v cmd '%q ' flock "$LOGIN_LOCK" "$ROOT/bin/vault-tec-plymouth" "$([[ $want == on ]] && echo install || echo uninstall)"
      omarchy-launch-floating-terminal-with-presentation "${cmd% }"
      for _ in {1..60}; do
        flock -n "$LOGIN_LOCK" true || break
        sleep 0.5
      done
      flock "$LOGIN_LOCK" true
      return
      ;;
    *) usage ;;
  esac || return
  run restart
}

usage() {
  echo "Usage: terminal-protocol-controller [status|install|set <bar|menu|cursor|crt|unlock|login> <on|off>]" >&2
  exit 1
}

case "${1:-status}" in
  status) status ;;
  install) install ;;
  set) set_part "$2" "$3" ;;
  *) usage ;;
esac
